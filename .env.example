# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme
POSTGRES_DB=football_prediction
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DSN (constructed from above in docker-compose; override here for local dev)
# DATABASE_URL=postgresql://football:changeme@localhost:5432/football_prediction

# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=false
LOG_LEVEL=INFO

# Initial bankroll for paper trading (euros)
INITIAL_BANKROLL=1000.0

# ── Odds source ───────────────────────────────────────────────────────────────
THE_ODDS_API_KEY=your-api-key-here
# THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ── Results source ────────────────────────────────────────────────────────────
# football-data.org — free tier is enough for finished-match results
FOOTBALL_DATA_API_KEY=

# ── Claude API (reserved for AI-generated bet rationales) ─────────────────────
ANTHROPIC_API_KEY=

# ── Fixtures source ───────────────────────────────────────────────────────────
# worldcup2026 GitHub API — no auth required, but token avoids rate limits
GITHUB_TOKEN=

# ── n8n webhooks ──────────────────────────────────────────────────────────────
# API key for n8n to authenticate against our webhook endpoints
# Leave empty to disable auth (safe if n8n is on the same private network)
WEBHOOK_API_KEY=

# ── Admin panel ───────────────────────────────────────────────────────────────
# Key required by /admin (entered once in the browser). Falls back to WEBHOOK_API_KEY.
# If both are empty the admin API is disabled. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# ── Telegram notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Chat ID: channel @name or numeric group/chat ID
TELEGRAM_CHAT_ID=

# ── X / Twitter via GetXAPI (optional) ────────────────────────────────────────
# X session cookies: auth_token, ct0 and (optionally) twid
GETXAPI_KEY=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_TWID=
